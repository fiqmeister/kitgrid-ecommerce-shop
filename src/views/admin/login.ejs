<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('../partials/admin-head', { title: 'Admin log in' }) %>
</head>

<body>
    <main class="admin-login-page">
        <div class="admin-login-box">
            <p class="admin-logo text-center mb-4">kitgrid彡</p>
            <div class="admin-login-card">
                <h1 class="h3 fw-bold text-center mb-4">Admin Log In</h1>

                <% if (locals.error) { %>
                    <div class="admin-error mb-4">
                        <span class="admin-error-icon">!</span>
                        <%= error %>
                    </div>
                    <% } %>

                        <form method="POST" action="/admin/login">
                            <div class="mb-3">
                                <label for="email" class="form-label fw-bold small">Email</label>
                                <input type="email" class="form-control" id="email" name="email"
                                    value="<%= locals.email || '' %>" required autofocus>
                            </div>
                            <div class="mb-4">
                                <label for="password" class="form-label fw-bold small">Password</label>
                                <input type="password" class="form-control" id="password" name="password" required>
                            </div>
                            <button type="submit" class="btn btn-kg w-100">Log in</button>
                        </form>

                        <p class="text-muted-kg small text-center mt-3 mb-0">This portal is for administrators only.</p>
            </div>
        </div>
    </main>

</body>

</html>