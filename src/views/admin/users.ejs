<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('../partials/admin-head', { title: 'Users' }) %>
</head>

<body>
    <%- include('../partials/admin-nav', { active: 'users' }) %>

        <main class="container py-4">

            <!-- title row -->
            <div class="d-flex justify-content-between align-items-baseline mb-3">
                <h1 class="h3 fw-bold mb-0">Users</h1>
                <span class="text-muted-kg">
                    <%= result.total %> users
                </span>
            </div>

            <!-- filters -->
            <form method="GET" action="/admin/users" class="admin-panel mb-4">
                <div class="row g-3 align-items-end">
                    <div class="col-12 col-md-5">
                        <label for="search" class="form-label fw-bold small">Search</label>
                        <input type="text" class="form-control" id="search" name="search" placeholder="Name or email"
                            value="<%= filters.search || '' %>">
                    </div>
                    <div class="col-12 col-md-3">
                        <label for="role" class="form-label fw-bold small">Role</label>
                        <select class="form-select" id="role" name="role">
                            <option value="">All roles</option>
                            <% Object.keys(roleLabels).forEach(value=> { %>
                                <option value="<%= value %>" <%=filters.role===value ? 'selected' : '' %>><%=
                                        roleLabels[value] %>
                                </option>
                                <% }) %>
                        </select>
                    </div>
                    <div class="col-12 col-md-4 d-flex align-items-center justify-content-md-end gap-3">
                        <button type="submit" class="btn btn-kg fs-6">Apply</button>
                        <a href="/admin/users" class="admin-link">Reset</a>
                    </div>
                </div>
            </form>

            <% if (result.users.length===0) { %>

                <div class="admin-panel text-center text-muted-kg py-5">No users match these filters.</div>

                <% } else { %>

                    <!-- users table (phone scrolls sideways) -->
                    <div class="admin-panel p-0 table-responsive">
                        <table class="table admin-table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Email</th>
                                    <th>Role</th>
                                    <th>Team</th>
                                    <th class="text-end">Orders</th>
                                    <th>Joined</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% result.users.forEach(user=> { %>
                                    <tr>
                                        <td class="fw-bold">
                                            <%= user.name %>
                                        </td>
                                        <td>
                                            <%= user.email %>
                                        </td>
                                        <td><span class="role-badge role-<%= user.role %>">
                                                <%= user.roleLabel %>
                                            </span></td>
                                        <td>
                                            <% if (user.teamName) { %>
                                                <%= user.teamName %>
                                                    <% } else { %>
                                                        <span class="text-muted-kg">No team</span>
                                                        <% } %>
                                        </td>
                                        <td class="text-end">
                                            <%= user.orderCount %>
                                        </td>
                                        <td>
                                            <%= user.joinedAt.toLocaleDateString('en-SG', { day: '2-digit' ,
                                                month: 'short' , year: 'numeric' }) %>
                                        </td>
                                    </tr>
                                    <% }) %>
                            </tbody>
                        </table>
                    </div>

                    <!-- "Showing 1 to ..." and the page buttons -->
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-3">
                        <span class="text-muted-kg small">
                            Showing <%= result.firstShown %> to <%= result.lastShown %> of <%= result.total %>
                        </span>

                        <% if (result.totalPages> 1) { %>
                            <ul class="pagination mb-0">
                                <li class="page-item <%= result.page <= 1 ? 'disabled' : '' %>">
                                    <a class="page-link"
                                        href="/admin/users?<%= filterQuery %>&page=<%= result.page - 1 %>">Prev</a>
                                </li>
                                <% for (let p=1; p <=result.totalPages; p++) { %>
                                    <li class="page-item <%= p === result.page ? 'active' : '' %>">
                                        <a class="page-link" href="/admin/users?<%= filterQuery %>&page=<%= p %>">
                                            <%= p %>
                                        </a>
                                    </li>
                                    <% } %>
                                        <li class="page-item <%= result.page >= result.totalPages ? 'disabled' : '' %>">
                                            <a class="page-link"
                                                href="/admin/users?<%= filterQuery %>&page=<%= result.page + 1 %>">Next</a>
                                        </li>
                            </ul>
                            <% } %>
                    </div>

                    <% } %>
        </main>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>