<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('../partials/admin-head', { title: 'Orders' }) %>
</head>

<body>
    <%- include('../partials/admin-nav', { active: 'orders' }) %>

        <main class="container py-4">

            <!-- title row -->
            <div class="d-flex justify-content-between align-items-baseline mb-3">
                <h1 class="h3 fw-bold mb-0">Orders</h1>
                <span class="text-muted-kg">
                    <%= result.total %> orders
                </span>
            </div>

            <!-- filters -->
            <form method="GET" action="/admin/orders" class="admin-panel mb-4">
                <div class="row g-3 align-items-end">
                    <div class="col-12 col-md-4">
                        <label for="search" class="form-label fw-bold small">Search</label>
                        <input type="text" class="form-control" id="search" name="search"
                            placeholder="Order # or customer name" value="<%= filters.search || '' %>">
                    </div>
                    <div class="col-12 col-md-2">
                        <label for="status" class="form-label fw-bold small">Status</label>
                        <select class="form-select" id="status" name="status">
                            <option value="">All statuses</option>
                            <% Object.keys(statusLabels).forEach(value=> { %>
                                <option value="<%= value %>" <%=filters.status===value ? 'selected' : '' %>><%=
                                        statusLabels[value] %>
                                </option>
                                <% }) %>
                        </select>
                    </div>
                    <div class="col-6 col-md-2">
                        <label for="from" class="form-label fw-bold small">From</label>
                        <input type="date" class="form-control" id="from" name="from" value="<%= filters.from || '' %>">
                    </div>
                    <div class="col-6 col-md-2">
                        <label for="to" class="form-label fw-bold small">To</label>
                        <input type="date" class="form-control" id="to" name="to" value="<%= filters.to || '' %>">
                    </div>
                    <div class="col-12 col-md-2 d-flex align-items-center gap-3">
                        <button type="submit" class="btn btn-kg fs-6">Apply</button>
                        <a href="/admin/orders" class="admin-link">Reset</a>
                    </div>
                </div>
            </form>

            <% if (result.orders.length===0) { %>

                <div class="admin-panel text-center text-muted-kg py-5">No orders match these filters.</div>

                <% } else { %>

                    <!-- orders table (phone scrolls sideways) -->
                    <div class="admin-panel p-0 table-responsive">
                        <table class="table admin-table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Order</th>
                                    <th>Placed</th>
                                    <th>Customer</th>
                                    <th>Units</th>
                                    <th>Total</th>
                                    <th>Status</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% result.orders.forEach(order=> { %>
                                    <tr>
                                        <td class="fw-bold">#<%= order.id %>
                                        </td>
                                        <td>
                                            <%= order.createdAt.toLocaleString('en-SG', { day: 'numeric' ,
                                                month: 'short' , hour: 'numeric' , minute: '2-digit' }) %>
                                        </td>
                                        <td>
                                            <div class="fw-bold">
                                                <%= order.customerName %>
                                            </div>
                                            <% if (order.teamName) { %>
                                                <div class="small text-muted-kg">
                                                    <%= order.teamName %>
                                                </div>
                                                <% } else { %>
                                                    <div class="small text-muted-kg">No team</div>
                                                    <% } %>
                                        </td>
                                        <td>
                                            <%= order.totalUnits %>
                                        </td>
                                        <td class="fw-bold">S$<%= order.total.toFixed(2) %>
                                        </td>
                                        <td><span class="status-badge status-<%= order.status %>">
                                                <%= order.statusLabel %>
                                            </span></td>
                                        <td class="text-end"><a href="/admin/orders/<%= order.id %>"
                                                class="fw-bold">View</a></td>
                                    </tr>
                                    <% }) %>
                            </tbody>
                        </table>
                    </div>

                    <!-- "Showing 1 to ..." and the page buttons -->
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-3">
                        <span class="text-muted-kg small">
                            Showing <%= result.firstShown %> to <%= result.lastShown %> of <%= result.total %>
                        </span>

                        <% if (result.totalPages> 1) { %>
                            <ul class="pagination mb-0">
                                <li class="page-item <%= result.page <= 1 ? 'disabled' : '' %>">
                                    <a class="page-link"
                                        href="/admin/orders?<%= filterQuery %>&page=<%= result.page - 1 %>">Prev</a>
                                </li>
                                <% for (let p=1; p <=result.totalPages; p++) { %>
                                    <li class="page-item <%= p === result.page ? 'active' : '' %>">
                                        <a class="page-link" href="/admin/orders?<%= filterQuery %>&page=<%= p %>">
                                            <%= p %>
                                        </a>
                                    </li>
                                    <% } %>
                                        <li class="page-item <%= result.page >= result.totalPages ? 'disabled' : '' %>">
                                            <a class="page-link"
                                                href="/admin/orders?<%= filterQuery %>&page=<%= result.page + 1 %>">Next</a>
                                        </li>
                            </ul>
                            <% } %>
                    </div>

                    <% } %>
        </main>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>